{
  "name": "dsh-safemode-profile",
  "version": "0.1.0",
  "description": "Install-time safemode profile writer: ensures ~/.dsh/profiles/safemode exists (whitelist: dsh-base + dsh-web-app) so `dsh --profile safemode` boots with zero third-party plugins",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/ensure.js",
    "scripts/ensure-safemode.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-safemode.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
